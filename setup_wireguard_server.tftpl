#!/bin/bash
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y wireguard

# 1. We use the keys Terraform gave us (Injected via template)
echo "${server_private_key}" > /etc/wireguard/private.key
echo "${server_public_key}" > /etc/wireguard/public.key
export interface_name=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | head -n 1)
# 2. Create the WireGuard Config
cat <<EOF > /etc/wireguard/wg0.conf
[Interface]
# --- Server Configuration ---
# The internal IP address the server will use inside the VPN tunnel.
Address = 10.0.0.1/24

# The port you opened in your AWS Security Group.
ListenPort = 47154

# Paste the content of 'server_private.key' here.
PrivateKey = ${server_private_key}

# --- Networking Rules (Crucial for Internet Access) ---
# These rules tell the server: "When traffic comes from the VPN, send it out to the internet (masquerade)."
# Note: 'eth0' is the standard AWS network interface. If yours is different, change it.
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -o $interface_name -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -o $interface_name -j MASQUERADE

[Peer]
# --- Client Configuration (Your Phone/Laptop) ---
# Paste the content of 'client_public.key' here.
PublicKey = ${client_public_key}

# The specific internal IP address you are assigning to this client.
AllowedIPs = 10.0.0.2/32
EOF

# 3. Start WireGuard
systemctl start wg-quick@wg0
systemctl enable wg-quick@wg0

# 4. Enable IP Forwarding (Required for VPNs)
sysctl -w net.ipv4.ip_forward=1
echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf